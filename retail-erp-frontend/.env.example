# ---------------------------------------------------------------------------
# Runtime — nginx reverse-proxy targets (change without rebuilding)
# ---------------------------------------------------------------------------
# The real URL of each .NET service as reachable FROM THIS CONTAINER.
# If the services are separate Dokploy apps, use their public domains.
# If they share a Docker network, use http://<service>:8080.
# NO trailing slash.
HR_UPSTREAM=https://hr-api.example.com
UM_UPSTREAM=https://usermanagement-api.example.com
SC_UPSTREAM=https://supplychain-api.example.com

# Host port published by docker compose (ignored by Dokploy's Traefik routing).
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# Build-time — inlined into the JS bundle (changing these REQUIRES a rebuild)
# ---------------------------------------------------------------------------
# PHP / Laravel API
REACT_APP_PHP_API=https://backend.orderwalabd.com/public/api

# Base URL for uploaded files (vendor_documents etc.)
REACT_APP_FILE_BASE=https://backend.orderwalabd.com/public/

# .NET clients. Keep these as same-origin paths so nginx proxies them.
# Replace with absolute URLs only if you want the browser to call the
# services directly (requires CORS to be enabled on each .NET service).
REACT_APP_HR_API=/dotnet/hr/api
REACT_APP_HR_SHIFT_API=/dotnet/um/api/
REACT_APP_UM_API=/dotnet/um/api/
REACT_APP_USER_API=/dotnet/um/api/UserManagement
REACT_APP_SC_API=/dotnet/sc/api
