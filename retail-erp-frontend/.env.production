# Production values (used by `npm run build`).
#
# The four .NET clients use SAME-ORIGIN relative paths. nginx in this container
# reverse-proxies /dotnet/hr, /dotnet/um and /dotnet/sc to the real services
# (upstreams are configured at runtime via HR_UPSTREAM / UM_UPSTREAM / SC_UPSTREAM).
# Same-origin means the browser never issues a CORS preflight against the .NET APIs.
#
# If you would rather call the .NET services directly, set these to absolute URLs
# (for example https://hr-api.example.com/api) instead.
#
# NOTE: Create React App inlines these at build time. Changing them requires a rebuild.

REACT_APP_PHP_API=https://backend.orderwalabd.com/public/api
REACT_APP_FILE_BASE=https://backend.orderwalabd.com/public/

REACT_APP_HR_API=/dotnet/hr/api
REACT_APP_HR_SHIFT_API=/dotnet/um/api/
REACT_APP_UM_API=/dotnet/um/api/
REACT_APP_USER_API=/dotnet/um/api/UserManagement
REACT_APP_SC_API=/dotnet/sc/api
