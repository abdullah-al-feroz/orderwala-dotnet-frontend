# Rendered by the nginx image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf at container start.
#
# Only ${HR_UPSTREAM} ${UM_UPSTREAM} ${SC_UPSTREAM} are substituted.
# nginx runtime variables ($host, $remote_addr, ...) are left untouched.

# Docker's internal DNS. Upstream names are resolved per request, so nginx
# still starts when a backend container is down or not started yet.
resolver 127.0.0.11 valid=10s ipv6=off;

# Dokploy/Traefik terminates TLS and forwards plain HTTP to this container.
# Keep the scheme the browser actually used so the .NET APIs don't emit
# http:// URLs or redirects for an HTTPS site.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    # Don't advertise the nginx version in responses/errors.
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    # Photo/attachment uploads go through the .NET services via the proxy below.
    client_max_body_size 50m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # ------------------------------------------------------------------
    # Health check used by the Dockerfile HEALTHCHECK
    # ------------------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # ------------------------------------------------------------------
    # .NET APIs — same-origin reverse proxy (no CORS)
    #
    #   /dotnet/hr/<path>  ->  ${HR_UPSTREAM}/<path>   HRServices
    #   /dotnet/um/<path>  ->  ${UM_UPSTREAM}/<path>   UserManagementServices
    #   /dotnet/sc/<path>  ->  ${SC_UPSTREAM}/<path>   SupplyChainServices
    #
    # proxy_pass uses a variable, so the hostname is resolved at request time
    # (via the resolver above). The rewrite strips the /dotnet/<x>/ prefix and
    # "break" keeps the query string, so /dotnet/hr/api/Staff/1?x=1 becomes
    # ${HR_UPSTREAM}/api/Staff/1?x=1.
    # ------------------------------------------------------------------
    location /dotnet/hr/ {
        set $hr_upstream "${HR_UPSTREAM}";
        rewrite ^/dotnet/hr/(.*)$ /$1 break;
        proxy_pass $hr_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_server_name on;
        proxy_connect_timeout 15s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /dotnet/um/ {
        set $um_upstream "${UM_UPSTREAM}";
        rewrite ^/dotnet/um/(.*)$ /$1 break;
        proxy_pass $um_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_server_name on;
        proxy_connect_timeout 15s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /dotnet/sc/ {
        set $sc_upstream "${SC_UPSTREAM}";
        rewrite ^/dotnet/sc/(.*)$ /$1 break;
        proxy_pass $sc_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_server_name on;
        proxy_connect_timeout 15s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # ------------------------------------------------------------------
    # Static assets
    # ------------------------------------------------------------------
    # CRA emits content-hashed files under /static/ — safe to cache forever.
    location /static/ {
        access_log off;
        expires 1y;
        try_files $uri =404;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
        expires 7d;
    }

    # Never cache the HTML shell, so new deployments are picked up immediately.
    location = /index.html {
        expires -1;
    }

    # ------------------------------------------------------------------
    # SPA fallback — every unknown path renders index.html (React Router)
    # ------------------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }
}